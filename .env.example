# ==============================================================================
# SPX — Capital Expenditure Request Management System (CER)
# Environment Configuration Template
# NOTE: Never commit production credentials, secrets, or keys to source control.
# ==============================================================================

# Target SharePoint Online Tenant & Site Collection
# UAT Target: Verify with project owner prior to deployment
SP_TARGET_SITE_URL=https://vedanta.sharepoint.com/sites/CERManagementSystemUAT
SP_UAT_SITE_URL=https://vedanta.sharepoint.com/sites/CERManagementSystemUAT

# SharePoint List Titles (Created automatically or provisioned via setup)
SP_LIST_PROPOSALS=CER_Proposals
SP_LIST_AUDIT_TRAIL=CER_AuditTrail
SP_LIST_REMARKS_HISTORY=CER_RemarksHistory
SP_LIST_WORKFLOW_LEVELS=CER_WorkflowLevels
SP_LIST_APPROVAL_DECISIONS=CER_ApprovalDecisions
SP_DOCLIB_ATTACHMENTS=CER_Attachments

# Local Mock Storage Configuration
# Set to 'true' to force local in-browser persistent storage even when hosted in workbench
REACT_APP_ENABLE_LOCAL_MOCK=false

# Notification Routing Mode: 'SHAREPOINT_REST' | 'GRAPH_API' | 'MOCK_ADAPTER'
NOTIFICATION_DELIVERY_MODE=MOCK_ADAPTER

# Development Workbench Port
PORT=4321
HTTPS=true
