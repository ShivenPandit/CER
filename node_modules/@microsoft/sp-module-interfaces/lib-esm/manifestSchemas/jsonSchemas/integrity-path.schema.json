{
  "$id": "integrity-path.schema.json",
  "title": "Integrity Path",
  "description": "A path value, either a plain string or an object with path and optional integrity hash.",
  "oneOf": [
    {
      "type": "string",
      "minLength": 1
    },
    {
      "type": "object",
      "required": ["path"],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "integrity": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    }
  ]
}
