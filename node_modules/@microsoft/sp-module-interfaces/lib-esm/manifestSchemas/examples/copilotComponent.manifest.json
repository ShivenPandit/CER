{
  "$schema": "./../jsonSchemas/client-side-component-manifest.schema.json",

  "manifestVersion": 2,
  "componentType": "CopilotComponent",
  "id": "00000000-0000-0000-0000-000000000000",
  "alias": "GreetingCopilotComponent",
  "version": "0.0.1",

  "copilotType": "Ux",
  "capabilities": {
    "availableDisplayModes": ["inline"]
  },
  "tools": [
    {
      "name": "GreetUser",
      "description": {
        "default": "Renders a greeting to an end user with confetti and other animations"
      },
      "propertiesSchema": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "description": "The name of the person to greet"
          }
        },
        "required": ["name"]
      }
    }
  ],

  "loaderConfig": {
    "internalModuleBaseUrls": ["https://cdn.net/"],
    "entryModuleId": "main.bundle",
    "scriptResources": {
      "main.bundle": {
        "type": "path",
        "path": "greeting-copilot-component.bundle.js"
      }
    }
  }
}
