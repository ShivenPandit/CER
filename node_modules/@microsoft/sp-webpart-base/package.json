{
  "name": "@microsoft/sp-webpart-base",
  "version": "1.24.0-beta.5",
  "description": "SharePoint Framework support for building web parts",
  "homepage": "http://aka.ms/spfx",
  "license": "https://aka.ms/spfx/license",
  "tsdoc": {
    "tsdocFlavor": "AEDoc"
  },
  "engines": {
    "node": ">=18.17.1 <19.0.0 || >=22.14.0 < 23.0.0"
  },
  "main": "lib-commonjs/index.js",
  "module": "lib-esm/index.js",
  "typings": "dist/index-internal.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index-internal.d.ts",
      "import": "./lib-esm/index.js",
      "require": "./lib-commonjs/index.js"
    },
    "./lib/*.resx": "./lib-esm/*.resx.json",
    "./lib/*": {
      "types": "./lib-dts/*.d.ts",
      "import": "./lib-esm/*.js",
      "require": "./lib-commonjs/*.js"
    },
    "./lib-commonjs/*.resx": "./lib-esm/*.resx.json",
    "./lib-commonjs/*": {
      "types": "./lib-dts/*.d.ts",
      "import": "./lib-esm/*.js",
      "require": "./lib-commonjs/*.js"
    },
    "./dist/test-api": {
      "types": "./dist/test-api/index.d.ts",
      "import": "./lib-esm/test-api/index.js",
      "require": "./lib-commonjs/test-api/index.js"
    },
    "./package.json": "./package.json"
  },
  "typesVersions": {
    "*": {
      "lib/*": [
        "lib-dts/*"
      ],
      "dist/test-api": [
        "dist/test-api/index"
      ]
    }
  },
  "dependencies": {
    "@fluentui/react": "^8.125.0",
    "@microsoft/teams-js-v2": "npm:@microsoft/teams-js@2.53.0",
    "@swc/helpers": "^0.5.12",
    "@types/office-js": "1.0.36",
    "react": "17.0.1",
    "react-dom": "17.0.1",
    "tslib": "2.3.1",
    "@microsoft/sp-component-base": "1.24.0-beta.5",
    "@microsoft/sp-core-library": "1.24.0-beta.5",
    "@microsoft/sp-diagnostics": "1.24.0-beta.5",
    "@microsoft/sp-http": "1.24.0-beta.5",
    "@microsoft/sp-http-base": "1.24.0-beta.5",
    "@microsoft/sp-lodash-subset": "1.24.0-beta.5",
    "@microsoft/sp-loader": "1.24.0-beta.5",
    "@microsoft/sp-module-interfaces": "1.24.0-beta.5",
    "@microsoft/sp-page-context": "1.24.0-beta.5",
    "@microsoft/sp-top-actions": "1.24.0-beta.5",
    "@microsoft/sp-property-pane": "1.24.0-beta.5"
  },
  "peerDependencies": {
    "@types/react": ">=17.0.45 <19.0.0",
    "@types/react-dom": ">=17.0.17 <19.0.0"
  },
  "devDependencies": {
    "@microsoft/load-themed-styles": "2.2.22",
    "@playwright/test": "1.61.1",
    "@rushstack/heft": "1.2.22",
    "@types/react": "18.2.79",
    "@types/react-dom": "18.2.25",
    "eslint": "9.37.0",
    "@msinternal/copilot-common": "3.16.0",
    "@msinternal/odsp-datasources": "59.1.0",
    "@msinternal/sp-a11y-checker-util": "0.1.0",
    "@msinternal/sp-edit-customer-promise": "0.1.0",
    "@msinternal/playwright-tab-utilities": "0.1.0",
    "@msinternal/sp-idle-web-task": "0.1.3",
    "@msinternal/sp-renderable-components-base": "5.3.21",
    "@msinternal/sp-tab-tasklib": "0.0.4",
    "@msinternal/sp-appbar-ngsp": "0.5.115",
    "@msinternal/spfx-internal-web-build-rig": "0.1.0",
    "@msinternal/sp-telemetry": "1.1.3"
  },
  "scripts": {
    "build": "heft test --clean",
    "clean": "heft clean",
    "deploy": "heft dev-deploy",
    "playwright": "heft playwright",
    "playwright-debug": "heft playwright --debug-mode",
    "start": "heft build-watch --serve",
    "tab": "heft tab",
    "test": "heft test",
    "test-watch": "heft test-watch",
    "_phase:build": "heft run --only build -- --clean",
    "_phase:build:incremental": "heft run --only build --",
    "_phase:depscan": "heft depscan",
    "_phase:tablink": "heft tablink",
    "_phase:test": "heft run --only test -- --clean",
    "_phase:test:incremental": "heft run --only test --"
  }
}