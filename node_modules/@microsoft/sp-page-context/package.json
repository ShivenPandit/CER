{
  "name": "@microsoft/sp-page-context",
  "version": "1.24.0-beta.5",
  "description": "Page context services for the SharePoint Framework",
  "homepage": "http://aka.ms/spfx",
  "license": "https://aka.ms/spfx/license",
  "tsdoc": {
    "tsdocFlavor": "AEDoc"
  },
  "engines": {
    "node": ">=18.17.1 <19.0.0 || >=22.14.0 < 23.0.0"
  },
  "main": "lib-commonjs/index.js",
  "module": "lib-esm/index.js",
  "typings": "dist/index-internal.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index-internal.d.ts",
      "import": "./lib-esm/index.js",
      "require": "./lib-commonjs/index.js"
    },
    "./lib/*.resx": "./lib-esm/*.resx.json",
    "./lib/*": {
      "types": "./lib-dts/*.d.ts",
      "import": "./lib-esm/*.js",
      "require": "./lib-commonjs/*.js"
    },
    "./lib-commonjs/*.resx": "./lib-esm/*.resx.json",
    "./lib-commonjs/*": {
      "types": "./lib-dts/*.d.ts",
      "import": "./lib-esm/*.js",
      "require": "./lib-commonjs/*.js"
    },
    "./dist/test-api": {
      "types": "./dist/test-api/index.d.ts",
      "import": "./lib-esm/test-api/index.js",
      "require": "./lib-commonjs/test-api/index.js"
    },
    "./package.json": "./package.json"
  },
  "typesVersions": {
    "*": {
      "lib/*": [
        "lib-dts/*"
      ],
      "dist/test-api": [
        "dist/test-api/index"
      ]
    }
  },
  "dependencies": {
    "@swc/helpers": "^0.5.12",
    "tslib": "2.3.1",
    "@microsoft/sp-diagnostics": "1.24.0-beta.5",
    "@microsoft/sp-core-library": "1.24.0-beta.5",
    "@microsoft/sp-lodash-subset": "1.24.0-beta.5",
    "@microsoft/sp-dynamic-data": "1.24.0-beta.5",
    "@microsoft/sp-odata-types": "1.24.0-beta.5"
  },
  "devDependencies": {
    "@rushstack/heft": "1.2.22",
    "eslint": "9.37.0",
    "@msinternal/spfx-internal-web-build-rig": "0.1.0"
  },
  "scripts": {
    "build": "heft test --clean",
    "clean": "heft clean",
    "deploy": "heft dev-deploy",
    "start": "heft build-watch --serve",
    "test": "heft test",
    "test-watch": "heft test-watch",
    "_phase:build": "heft run --only build -- --clean",
    "_phase:build:incremental": "heft run --only build --",
    "_phase:depscan": "heft depscan",
    "_phase:test": "heft run --only test -- --clean",
    "_phase:test:incremental": "heft run --only test --"
  }
}