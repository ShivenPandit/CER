{
  "name": "@microsoft/sp-loader",
  "version": "1.24.0-beta.5",
  "description": "The SharePoint Framework loader",
  "homepage": "http://aka.ms/spfx",
  "license": "https://aka.ms/spfx/license",
  "tsdoc": {
    "tsdocFlavor": "AEDoc"
  },
  "engines": {
    "node": ">=18.17.1 <19.0.0 || >=22.14.0 < 23.0.0"
  },
  "main": "lib-commonjs/index.js",
  "module": "lib-esm/index.js",
  "typings": "dist/index-internal.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index-internal.d.ts",
      "import": "./lib-esm/index.js",
      "require": "./lib-commonjs/index.js"
    },
    "./lib/*.resx": "./lib-esm/*.resx.json",
    "./lib/*": {
      "types": "./lib-dts/*.d.ts",
      "import": "./lib-esm/*.js",
      "require": "./lib-commonjs/*.js"
    },
    "./lib-commonjs/*.resx": "./lib-esm/*.resx.json",
    "./lib-commonjs/*": {
      "types": "./lib-dts/*.d.ts",
      "import": "./lib-esm/*.js",
      "require": "./lib-commonjs/*.js"
    },
    "./package.json": "./package.json"
  },
  "typesVersions": {
    "*": {
      "lib/*": [
        "lib-dts/*"
      ]
    }
  },
  "dependencies": {
    "@fluentui/react": "^8.125.0",
    "@rushstack/loader-raw-script": "1.6.22",
    "@swc/helpers": "^0.5.12",
    "@types/requirejs": "2.1.29",
    "raw-loader": "~0.5.1",
    "react": "17.0.1",
    "react-dom": "17.0.1",
    "requirejs": "2.3.7",
    "tslib": "2.3.1",
    "@microsoft/sp-diagnostics": "1.24.0-beta.5",
    "@microsoft/sp-dynamic-data": "1.24.0-beta.5",
    "@microsoft/sp-core-library": "1.24.0-beta.5",
    "@microsoft/sp-http-base": "1.24.0-beta.5",
    "@microsoft/sp-lodash-subset": "1.24.0-beta.5",
    "@microsoft/sp-odata-types": "1.24.0-beta.5",
    "@microsoft/sp-module-interfaces": "1.24.0-beta.5",
    "@microsoft/sp-page-context": "1.24.0-beta.5"
  },
  "peerDependencies": {
    "@types/react": ">=17.0.45 <19.0.0",
    "@types/react-dom": ">=17.0.17 <19.0.0"
  },
  "devDependencies": {
    "@rushstack/heft": "1.2.22",
    "@types/react": "18.2.79",
    "@types/react-dom": "18.2.25",
    "@types/sinon": "1.16.34",
    "@types/systemjs": "0.19.33",
    "eslint": "9.37.0",
    "sinon": "~1.17.6",
    "@microsoft/sp-diagnostics": "1.24.0-beta.5",
    "@msinternal/react-query-bundle": "4.36.1",
    "@msinternal/sp-telemetry": "1.1.3",
    "@msinternal/sp-flight-inspector": "0.1.0",
    "@msinternal/spfx-internal-web-build-rig": "0.1.0",
    "@msinternal/spfx-manifests-file": "0.1.0",
    "@msinternal/swc-helpers-bundle": "0.5.13",
    "@msinternal/sp-service-worker-inspector": "0.4.301",
    "@msinternal/tweak-spfx-webpack-config-plugin": "0.1.0",
    "@msinternal/tslib-2-bundle": "2.3.1"
  },
  "scripts": {
    "build": "heft test --clean",
    "clean": "heft clean",
    "deploy": "heft dev-deploy",
    "start": "heft build-watch --serve",
    "test": "heft test",
    "test-watch": "heft test-watch",
    "_phase:build": "heft run --only build -- --clean",
    "_phase:build:incremental": "heft run --only build --",
    "_phase:depscan": "heft depscan",
    "_phase:test": "heft run --only test -- --clean",
    "_phase:test:incremental": "heft run --only test --"
  }
}