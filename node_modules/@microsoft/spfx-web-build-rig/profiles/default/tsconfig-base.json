{
  "$schema": "http://json.schemastore.org/tsconfig",

  "compilerOptions": {
    "forceConsistentCasingInFileNames": true,
    "jsx": "react",
    "declaration": true,
    "sourceMap": true,
    "declarationMap": true,
    "inlineSources": true,
    "experimentalDecorators": true,
    "strict": true,
    "esModuleInterop": true,
    "noEmitOnError": false,
    "allowUnreachableCode": false,
    "noImplicitAny": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,

    "module": "esnext",
    "moduleResolution": "node",
    "target": "es5",

    "importHelpers": true,
    "importsNotUsedAsValues": "remove",

    "types": ["jest", "webpack-env"],
    "typeRoots": ["../../../../../node_modules/@types", "../../node_modules/@types"],

    "lib": [
      "dom",
      "es5",
      "es2015.core",
      "es2015.collection",
      "es2015.iterable",
      "es2015.promise",
      "es2015.proxy"
    ],

    "outDir": "../../../../../lib",
    "rootDir": "../../../../../src",
    "rootDirs": [
      "../../../../../src",
      "../../../../../temp/loc-ts",
      "../../../../../temp/sass-ts",
      "../../../../../temp/static-asset-ts"
    ]
  },
  "include": ["../../../../../src/**/*.ts", "../../../../../src/**/*.tsx"]
}
