{
  "$schema": "https://developer.microsoft.com/json-schemas/rush/v5/rush-project.schema.json",

  "operationSettings": [
    {
      "operationName": "_phase:build",
      "outputFolderNames": [
        "dist",
        "lib",
        "lib-dts",
        "release",
        "temp/build",
        "temp/generated-code",
        "temp/loc-ts",
        "temp/sass-ts",
        "temp/static-asset-ts"
      ]
    },
    {
      "operationName": "_phase:test",
      "outputFolderNames": ["jest-output", "temp/test"]
    },
    {
      "operationName": "_phase:package-solution",
      "outputFolderNames": ["sharepoint/solution"]
    }
  ]
}
