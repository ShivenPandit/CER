{
  "name": "@microsoft/sp-property-pane",
  "version": "1.24.0-beta.5",
  "description": "SharePoint Framework support for the property pane user interface.",
  "homepage": "http://aka.ms/spfx",
  "license": "https://aka.ms/spfx/license",
  "engines": {
    "node": ">=18.17.1 <19.0.0 || >=22.14.0 < 23.0.0"
  },
  "main": "lib-commonjs/index.js",
  "module": "lib-esm/index.js",
  "typings": "dist/index-internal.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index-internal.d.ts",
      "import": "./lib-esm/index.js",
      "require": "./lib-commonjs/index.js"
    },
    "./lib/*.resx": "./lib-esm/*.resx.json",
    "./lib/*": {
      "types": "./lib-dts/*.d.ts",
      "import": "./lib-esm/*.js",
      "require": "./lib-commonjs/*.js"
    },
    "./lib-commonjs/*.resx": "./lib-esm/*.resx.json",
    "./lib-commonjs/*": {
      "types": "./lib-dts/*.d.ts",
      "import": "./lib-esm/*.js",
      "require": "./lib-commonjs/*.js"
    },
    "./package.json": "./package.json"
  },
  "typesVersions": {
    "*": {
      "lib/*": [
        "lib-dts/*"
      ]
    }
  },
  "dependencies": {
    "@fluentui/react": "^8.125.0",
    "@fluentui/react-components": "^9.74.1",
    "@fluentui/react-icons": "2.0.314",
    "@fluentui/react-tabster": "^9.26.15",
    "@fluentui/utilities": "^8.17.0",
    "@swc/helpers": "^0.5.12",
    "react": "17.0.1",
    "react-dom": "17.0.1",
    "tslib": "2.3.1",
    "@microsoft/sp-component-base": "1.24.0-beta.5",
    "@microsoft/sp-core-library": "1.24.0-beta.5",
    "@microsoft/sp-dynamic-data": "1.24.0-beta.5",
    "@microsoft/sp-diagnostics": "1.24.0-beta.5",
    "@microsoft/sp-image-helper": "1.24.0-beta.5",
    "@microsoft/sp-page-context": "1.24.0-beta.5",
    "@microsoft/sp-lodash-subset": "1.24.0-beta.5"
  },
  "peerDependencies": {
    "@types/react": ">=17.0.45 <19.0.0",
    "@types/react-dom": ">=17.0.17 <19.0.0"
  },
  "devDependencies": {
    "@fluentui/react-theme-sass": "^9.0.0-alpha.30",
    "@playwright/test": "1.61.1",
    "@rushstack/heft": "1.2.22",
    "@types/enzyme": "3.10.8",
    "@types/enzyme-adapter-react-16": "1.0.5",
    "@types/react": "18.2.79",
    "@types/react-dom": "18.2.25",
    "enzyme": "^3.11.0",
    "enzyme-adapter-react-16": "npm:@wojtekmaj/enzyme-adapter-react-17@0.6.7",
    "eslint": "9.37.0",
    "@microsoft/sp-module-interfaces": "1.24.0-beta.5",
    "@microsoft/sp-loader": "1.24.0-beta.5",
    "@ms/office-ui-fabric-react-bundle": "1.19.66",
    "@msinternal/fluentui-neutral-components": "0.4.6",
    "@msinternal/odsp-utilities-bundle": "5.6.745",
    "@msinternal/odsp-core-bundle": "1.5.223",
    "@msinternal/screen-reader-alert": "2.0.1",
    "@msinternal/fluentui-staging": "2.0.73",
    "@msinternal/playwright-tab-utilities": "0.1.0",
    "@msinternal/sharepoint-ui-react-stable-bundle": "0.1.0",
    "@msinternal/sp-appbar-ngsp": "0.5.115",
    "@msinternal/sp-filepicker-host": "0.1.0",
    "@msinternal/sp-filepicker-interfaces": "0.18.43",
    "@msinternal/sp-file-handler": "0.1.0",
    "@msinternal/sp-component-utilities": "13.16.90",
    "@msinternal/sp-getty": "0.1.0",
    "@msinternal/sp-heading-level": "0.1.0",
    "@msinternal/sp-fluentui-migration-meta-bundle": "0.1.0",
    "@msinternal/sp-tab-tasklib": "0.0.4",
    "@msinternal/sp-telemetry": "1.1.3",
    "@msinternal/sp-pages-content-panel-context": "0.1.0",
    "@msinternal/spfx-internal-web-build-rig": "0.1.0"
  },
  "scripts": {
    "build": "heft test --clean",
    "clean": "heft clean",
    "deploy": "heft dev-deploy",
    "playwright": "heft playwright",
    "playwright-debug": "heft playwright --debug-mode",
    "start": "heft build-watch --serve",
    "tab": "heft tab",
    "test": "heft test",
    "test-watch": "heft test-watch",
    "_phase:build": "heft run --only build -- --clean",
    "_phase:build:incremental": "heft run --only build --",
    "_phase:depscan": "heft depscan",
    "_phase:tablink": "heft tablink",
    "_phase:test": "heft run --only test -- --clean",
    "_phase:test:incremental": "heft run --only test --"
  }
}