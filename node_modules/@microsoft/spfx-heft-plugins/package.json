{
  "name": "@microsoft/spfx-heft-plugins",
  "version": "1.24.0-beta.5",
  "description": "Plugin package for building SPFx projects with Heft",
  "homepage": "http://aka.ms/spfx",
  "license": "https://aka.ms/spfx/license",
  "author": "xFun",
  "main": "lib-commonjs/index.js",
  "module": "lib-esm/index.js",
  "typings": "lib-dts/index.d.ts",
  "exports": {
    ".": {
      "import": "./lib-esm/index.js",
      "require": "./lib-commonjs/index.js",
      "types": "./lib-dts/index.d.ts"
    },
    "./lib/*": {
      "import": "./lib-esm/*.js",
      "require": "./lib-commonjs/*.js",
      "types": "./lib-dts/*.d.ts"
    },
    "./package.json": "./package.json"
  },
  "typesVersions": {
    "*": {
      "lib/*": [
        "lib-dts/*"
      ]
    }
  },
  "dependencies": {
    "@azure/storage-blob": "~12.26.0",
    "@microsoft/app-manifest": "1.1.1",
    "@modelcontextprotocol/sdk": "~1.29.0",
    "@rushstack/heft-config-file": "0.20.12",
    "@rushstack/localization-utilities": "0.16.0",
    "@rushstack/module-minifier": "0.9.24",
    "@rushstack/node-core-library": "5.23.3",
    "@rushstack/rig-package": "0.7.3",
    "@rushstack/set-webpack-public-path-plugin": "5.3.24",
    "@rushstack/terminal": "0.24.2",
    "@rushstack/webpack5-localization-plugin": "0.16.23",
    "@rushstack/webpack5-module-minifier-plugin": "5.8.24",
    "@types/tapable": "1.0.6",
    "cors": "2.8.5",
    "express": "4.22.1",
    "fast-glob": "~3.2.12",
    "git-repo-info": "~2.1.1",
    "html-loader": "~4.2.0",
    "jszip": "~3.8.0",
    "lodash": "~4.18.1",
    "mime": "2.5.2",
    "resolve": "~1.17.0",
    "source-map": "0.6.1",
    "source-map-loader": "~4.0.1",
    "tapable": "1.1.3",
    "uuid": "^9.0.0",
    "webpack": "5.105.4",
    "xml": "~1.0.1",
    "@microsoft/sp-css-loader": "1.24.0-beta.5",
    "@microsoft/sp-module-interfaces": "1.24.0-beta.5"
  },
  "peerDependencies": {
    "@rushstack/heft": "^1.1.5"
  },
  "devDependencies": {
    "@rushstack/heft": "1.2.22",
    "@rushstack/heft-dev-cert-plugin": "1.1.23",
    "@rushstack/heft-jest-plugin": "2.0.12",
    "@rushstack/heft-lint-plugin": "1.2.22",
    "@rushstack/heft-sass-plugin": "1.4.6",
    "@rushstack/heft-typescript-plugin": "1.3.17",
    "@rushstack/heft-webpack5-plugin": "1.3.23",
    "@types/cors": "~2.8.12",
    "@types/express": "4.17.21",
    "@types/glob": "^7.1.1",
    "@types/lodash": "4.14.117",
    "@types/mime": "2.0.3",
    "@types/resolve": "1.17.1",
    "@types/uuid": "9.0.1",
    "@types/xml": "1.0.3",
    "cors": "2.8.5",
    "eslint": "9.37.0",
    "express": "4.22.1",
    "glob": "^7.1.2",
    "memfs": "3.4.3",
    "sass-embedded": "1.85.1",
    "sass-loader": "~16.0.7",
    "style-loader": "1.1.3",
    "ts-loader": "9.5.1",
    "typescript": "5.3.3",
    "@msinternal/localized-resources-heft-plugin": "0.8.0",
    "@microsoft/sp-module-interfaces": "1.24.0-beta.5",
    "@msinternal/spfx-manifests-file": "0.1.0",
    "@msinternal/internal-node-rig": "0.1.0"
  },
  "sideEffects": false,
  "scripts": {
    "build": "heft test --clean",
    "build-watch": "heft run --only build --",
    "clean": "heft clean",
    "start": "heft build-watch --serve",
    "test": "heft run --only test -- --clean",
    "test-watch": "heft test-watch",
    "_phase:depscan": "heft depscan",
    "_phase:test": "heft run --only test -- --clean",
    "_phase:test:incremental": "heft run --only test --",
    "_phase:tool-build": "heft run --only build -- --clean",
    "_phase:tool-build:incremental": "heft run --only build --"
  }
}